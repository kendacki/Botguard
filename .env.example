BOTGUARD_MEMORY_MODE=1
INLINE_WORKER=1
API_PORT=8080
PORT=8080
MONITOR_TOKEN=demo-monitor-token
CRED_CACHE_TTL=3
QUEUE_DEPTH_THRESHOLD=50
INDEXER_LAG_THRESHOLD=30
DATABASE_URL=postgres://botguard:botguard@localhost:5432/botguard
REDIS_URL=redis://localhost:6379
QUEUE_URL=amqp://guest:guest@localhost:5672

# Network defaults: keep testnet values for local/dev behavior and override for mainnet deploys.
BOTCHAIN_NETWORK=testnet
BOTCHAIN_RPC_URL=https://rpc.bohr.life
BOTCHAIN_TESTNET_RPC=https://rpc.bohr.life
BOTCHAIN_CHAIN_ID=968

# Mainnet overrides (set only when deploying on BOT Chain mainnet)
BOTCHAIN_MAINNET_RPC=
BOTCHAIN_MAINNET_CHAIN_ID=
BOTCHAIN_MAINNET_API_URL=

DEPLOYER_PRIVATE_KEY=
ISSUER_PRIVATE_KEY=
TREASURY_ADDRESS=
VERIFICATION_FEE=
CREDENTIAL_REGISTRY_ADDRESS=
ISSUER_REGISTRY_ADDRESS=
VERIFICATION_PASS_ADDRESS=
DEMO_API_KEY=demo-issuer-key
# Comma-separated origins for production (Vercel URL). Use * for local demos.
CORS_ORIGIN=*
