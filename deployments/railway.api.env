# BOTGUARD API — Railway environment (mainnet)
# Apply with: railway variables --set "KEY=value"  (or paste in Railway dashboard)

NODE_ENV=production
BOTGUARD_MEMORY_MODE=1
INLINE_WORKER=1
DEMO_API_KEY=demo-issuer-key
MONITOR_TOKEN=demo-monitor-token
CORS_ORIGIN=https://botguard-five.vercel.app
CRED_CACHE_TTL=3
QUEUE_DEPTH_THRESHOLD=50
INDEXER_LAG_THRESHOLD=30
RATE_LIMIT_PER_MIN=120

# BOT Chain mainnet
BOTCHAIN_NETWORK=mainnet
BOTCHAIN_MAINNET_RPC=https://rpc.botchain.ai
BOTCHAIN_MAINNET_CHAIN_ID=677
BOTCHAIN_TESTNET_RPC=https://rpc.bohr.life
CHAIN_RPC_URL=https://rpc.botchain.ai
BOTCHAIN_CHAIN_ID=677
BOTCHAIN_MAINNET_API_URL=https://botguard-production-7c4d.up.railway.app
ISSUER_REGISTRY_ADDRESS=0xdD1A560a36463a5AD848a3351B4D1649a17e8003
CREDENTIAL_REGISTRY_ADDRESS=0x84DB2c6be30a716084e668F3609e1914D80e7f2e
EXAMPLE_RWA_TOKEN_ADDRESS=0x3716d9027c70C3dc3eCa4FaE842ba96aC5114295
VERIFICATION_PASS_ADDRESS=0x198E4465d07EdB5A31226172874C9214f6307929
TREASURY_ADDRESS=0x4b20FACB4a1c834e6cBEAeeE8FFAe3330aBAb4bD
VERIFICATION_FEE=500000000000000000

# BOT Chain mainnet issuer / deployer
ISSUER_ADDRESS=0x2132c6aEd2EDaC0e6aD59Cb17C5cc7697064d6D6

# Required for on-chain issue/revoke/reject when CHAIN_RPC_URL is set.
# Set in Railway dashboard only (never commit).
# ISSUER_PRIVATE_KEY=
