# BOTGUARD API — Railway environment (production / testnet)
# Apply with: railway variables --set "KEY=value"  (or paste in Railway dashboard)

NODE_ENV=production
BOTGUARD_MEMORY_MODE=1
INLINE_WORKER=1
DEMO_API_KEY=demo-issuer-key
MONITOR_TOKEN=demo-monitor-token
CORS_ORIGIN=https://botguard-five.vercel.app
CRED_CACHE_TTL=3
QUEUE_DEPTH_THRESHOLD=50
INDEXER_LAG_THRESHOLD=30
RATE_LIMIT_PER_MIN=120

# BOT Chain Testnet
BOTCHAIN_TESTNET_RPC=https://rpc.bohr.life
CHAIN_RPC_URL=https://rpc.bohr.life
BOTCHAIN_CHAIN_ID=968
ISSUER_REGISTRY_ADDRESS=0x1eCc7c37E9074D5aE6C47a4ED21c4dFCd759e6CD
CREDENTIAL_REGISTRY_ADDRESS=0xfcdD8c5823dcDEE47836bfbAd03A425DFd1C0fe5
EXAMPLE_RWA_TOKEN_ADDRESS=0x8b54AB355FeAa0cd7b8726DE4Cd2B163C5cf38c3
TREASURY_ADDRESS=0x4b20FACB4a1c834e6cBEAeeE8FFAe3330aBAb4bD
VERIFICATION_FEE=500000000000000000

# Required for on-chain issue/revoke/reject when CHAIN_RPC_URL is set.
# Set in Railway dashboard only (never commit).
# ISSUER_PRIVATE_KEY=
